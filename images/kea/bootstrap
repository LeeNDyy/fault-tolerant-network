#!/bin/sh
set -eu
for password in "$KEA_DB_PASSWORD" "$STORK_DB_PASSWORD"; do
    case "$password" in *[!A-Za-z0-9]*|"") exit 2 ;; esac
    [ "${#password}" -ge 20 ]
done
export PGCONNECT_TIMEOUT=3
export PGPASSWORD="$PG_SUPER_PASSWORD"
until psql -h "$DB_HOST" -U postgres -d postgres -Atqc 'SELECT NOT pg_is_in_recovery()' | grep -qx t; do
    sleep 2
done
psql -X -h "$DB_HOST" -U postgres -d postgres -v ON_ERROR_STOP=1 <<SQL
SELECT format('CREATE ROLE kea LOGIN PASSWORD %L', '$KEA_DB_PASSWORD')
WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'kea') \gexec
SELECT format('CREATE ROLE stork LOGIN PASSWORD %L', '$STORK_DB_PASSWORD')
WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'stork') \gexec
ALTER ROLE kea PASSWORD '$KEA_DB_PASSWORD';
ALTER ROLE stork PASSWORD '$STORK_DB_PASSWORD';
SELECT 'CREATE DATABASE keadb OWNER kea'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'keadb') \gexec
SELECT 'CREATE DATABASE storkdb OWNER stork'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'storkdb') \gexec
SQL
psql -X -h "$DB_HOST" -U postgres -d storkdb -v ON_ERROR_STOP=1 -c 'CREATE EXTENSION IF NOT EXISTS pgcrypto'
if [ "$(PGPASSWORD="$KEA_DB_PASSWORD" psql -h "$DB_HOST" -U kea -d keadb -Atqc "SELECT to_regclass('public.schema_version') IS NULL")" = t ]; then
    kea-admin db-init pgsql -h "$DB_HOST" -u kea -p "$KEA_DB_PASSWORD" -n keadb
fi
kea-admin db-version pgsql -h "$DB_HOST" -u kea -p "$KEA_DB_PASSWORD" -n keadb
